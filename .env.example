# Server only. Never commit a real key and never put one in the frontend.
# Local: this file's sibling .env is loaded when the API starts.
# Production: the same names are read from the Cloud Function environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Optional. Empty uses the newest Pro model from /models, or deepseek-v4-pro.
DEEPSEEK_MODEL=
