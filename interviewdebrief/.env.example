# Public site. Change only if the Hosting site ID collides and you deploy interviewdebrief1.
NEXT_PUBLIC_APP_URL=https://interviewdebrief.web.app

# Midtrans Snap. Leave blank to ship marketing + articles only.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Optional. Without this key the scorecard still uses the built-in coach copy.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Firestore named database on skoolnow-ea6ff. Server only.
FIREBASE_PROJECT_ID=skoolnow-ea6ff
FIREBASE_DATABASE_ID=interviewdebrief
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dev only. Production refuses the file store unless this is true.
ALLOW_FILE_STORE=false
